# Copie para .env e preencha os valores reais. Nunca commite .env (ver .gitignore).

# Banco de dados
# DATABASE_URL: role ADMINISTRATIVA (superuser da imagem postgres:*) — usada SOMENTE por
# `prisma migrate` (DDL) e por scripts/apply-role-grants.mjs. NUNCA usada pela aplicação em runtime
# (ver security-engineer finding C-1 — RLS nunca se aplica a um superuser Postgres).
POSTGRES_PASSWORD=devpassword
DATABASE_URL=postgresql://estoque_app:devpassword@localhost:5432/estoque_saas

# APP_DATABASE_URL: role restrita ("app_user", NOBYPASSRLS — criada por
# schemas/migrations/0003_app_role_and_grants.sql), usada pela aplicação (services/app) e pelo
# worker em runtime. É esta conexão que efetivamente sofre a Row-Level Security por tenant.
APP_DB_PASSWORD=devpassword-app-user
APP_DATABASE_URL=postgresql://app_user:devpassword-app-user@localhost:5432/estoque_saas

# PLATFORM_ADMIN_DATABASE_URL: role "platform_admin_role" (BYPASSRLS deliberado — ver
# schemas/migrations/0006_platform_admin_role.sql), usada SOMENTE pelo módulo admin
# (services/app/src/modules/admin) para o painel interno do dono do SaaS (lista todos os tenants,
# métricas). Nunca usada por rotas tenant-scoped.
PLATFORM_ADMIN_DB_PASSWORD=devpassword-platform-admin
PLATFORM_ADMIN_DATABASE_URL=postgresql://platform_admin_role:devpassword-platform-admin@localhost:5432/estoque_saas

# Sessão do painel administrativo interno (cookie __Host-platform-session) — HMAC próprio,
# separado do Auth.js/NextAuth de tenants (zero-trust interno, ver design-principles.md).
PLATFORM_ADMIN_SESSION_SECRET=changeme-generate-with-openssl-rand-base64-32

# Redis (fila de jobs + cache)
REDIS_URL=redis://localhost:6379

# Auth.js
AUTH_SECRET=changeme-generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

# PagBank/PagSeguro (ADR-004) — credenciais de sandbox para desenvolvimento
PAGBANK_API_KEY=
PAGBANK_BASE_URL=https://sandbox.api.pagseguro.com
PAGBANK_WEBHOOK_SECRET=

# Painel administrativo interno (platform_admins) — bootstrap do primeiro admin
PLATFORM_ADMIN_BOOTSTRAP_EMAIL=
PLATFORM_ADMIN_BOOTSTRAP_PASSWORD=
