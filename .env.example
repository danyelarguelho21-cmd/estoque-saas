# Copie para .env e preencha os valores reais. Nunca commite .env (ver .gitignore).

# Banco de dados
POSTGRES_PASSWORD=devpassword
DATABASE_URL=postgresql://estoque_app:devpassword@localhost:5432/estoque_saas

# Redis (fila de jobs + cache)
REDIS_URL=redis://localhost:6379

# Auth.js
AUTH_SECRET=changeme-generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

# PagBank/PagSeguro (ADR-004) — credenciais de sandbox para desenvolvimento
PAGBANK_API_KEY=
PAGBANK_BASE_URL=https://sandbox.api.pagseguro.com
PAGBANK_WEBHOOK_SECRET=

# Painel administrativo interno (platform_admins) — bootstrap do primeiro admin
PLATFORM_ADMIN_BOOTSTRAP_EMAIL=
PLATFORM_ADMIN_BOOTSTRAP_PASSWORD=
