// Prisma schema — espelha schemas/migrations/0001_init.sql (fonte de verdade das políticas RLS).
// Ver docs/architecture/architecture-decision-records/ADR-002-multi-tenancy-strategy.md.
//
// IMPORTANTE: todo campo id/FK que a ERD (schemas/erd.md) declara como `uuid` tem `@db.Uuid`
// explícito aqui. Sem isso, Prisma mapeia `String @id @default(uuid())` para a coluna Postgres
// `text` (não o tipo nativo `uuid`) — descoberto rodando uma migração real contra Postgres neste
// ambiente (boot-smoke, fase BUILD): as funções SECURITY DEFINER (0004/0005/0007) declaram
// `RETURNS TABLE (tenant_id uuid, ...)` e todo `$queryRaw`/`$executeRaw` deste código faz cast
// `${valor}::uuid` — com colunas `text`, a comparação `text = uuid` nem sequer tem operador
// definido no Postgres (erro em runtime), e a criação das funções falhava na validação de tipo de
// retorno. Isso teria quebrado silenciosamente (só em runtime, nunca no typecheck) se não tivesse
// sido pego rodando o boot-smoke real.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Plan {
  id           String         @id @default(uuid()) @db.Uuid
  name         String
  priceCents   Int            @map("price_cents")
  maxProducts  Int            @map("max_products")
  maxUsers     Int            @map("max_users")
  maxStores    Int            @map("max_stores")
  features     Json           @default("{}")
  createdAt    DateTime       @default(now()) @map("created_at")
  tenants      Tenant[]
  subscriptions Subscription[]

  @@map("plans")
}

model PlatformAdmin {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("platform_admins")
}

model Tenant {
  id                         String   @id @default(uuid()) @db.Uuid
  name                       String
  // Pessoa jurídica (CNPJ) OU pessoa física (CPF) — exatamente um dos dois é preenchido,
  // validado na camada de aplicação (ver isValidCnpj/isValidCpf em src/lib/format.ts e
  // SignupSchema em api/auth/signup/route.ts). NULL em ambos ou nos dois ao mesmo tempo nunca
  // deveria acontecer, mas o banco não força isso via CHECK constraint — é reforçado no signup.
  personType                 String   @default("PJ") @map("person_type") // "PF" | "PJ"
  cnpj                       String?  @unique
  cpf                        String?  @unique
  planId                     String   @map("plan_id") @db.Uuid
  plan                       Plan     @relation(fields: [planId], references: [id])
  consolidatedStock          Boolean  @default(false) @map("consolidated_stock")
  perishableTrackingEnabled  Boolean  @default(false) @map("perishable_tracking_enabled")
  status                     String   @default("active")
  createdAt                  DateTime @default(now()) @map("created_at")

  users         User[]
  stores        Store[]
  suppliers     Supplier[]
  categories    Category[]
  products      Product[]
  customers     Customer[]
  subscriptions Subscription[]
  invoices      Invoice[]
  auditLogs     AuditLog[]
  alertsConfig  StockAlertsConfig?

  @@map("tenants")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  name         String
  email        String
  passwordHash String   @map("password_hash")
  role         String
  status       String   @default("active")
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([tenantId, email])
  @@map("users")
}

model Store {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  type      String   @default("loja")
  address   String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("stores")
}

model Subscription {
  id                     String    @id @default(uuid()) @db.Uuid
  tenantId               String    @map("tenant_id") @db.Uuid
  tenant                 Tenant    @relation(fields: [tenantId], references: [id])
  planId                 String    @map("plan_id") @db.Uuid
  plan                   Plan      @relation(fields: [planId], references: [id])
  status                 String
  paymentMethod          String    @map("payment_method")
  gatewayCustomerId      String?   @map("gateway_customer_id")
  gatewaySubscriptionId  String?   @map("gateway_subscription_id")
  currentPeriodStart     DateTime? @map("current_period_start")
  currentPeriodEnd       DateTime? @map("current_period_end")
  createdAt              DateTime  @default(now()) @map("created_at")
  invoices               Invoice[]

  @@map("subscriptions")
}

model Invoice {
  id               String       @id @default(uuid()) @db.Uuid
  tenantId         String       @map("tenant_id") @db.Uuid
  tenant           Tenant       @relation(fields: [tenantId], references: [id])
  subscriptionId   String       @map("subscription_id") @db.Uuid
  subscription     Subscription @relation(fields: [subscriptionId], references: [id])
  amountCents      Int          @map("amount_cents")
  status           String
  dueDate          DateTime     @map("due_date") @db.Date
  paidAt           DateTime?    @map("paid_at")
  paymentMethod    String       @map("payment_method")
  gatewayChargeId  String?      @map("gateway_charge_id")
  gatewayEventId   String?      @unique @map("gateway_event_id")
  pixQrCode        String?      @map("pix_qr_code")
  boletoUrl        String?      @map("boleto_url")
  createdAt        DateTime     @default(now()) @map("created_at")

  @@map("invoices")
}

model Supplier {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  cnpj      String?
  contact   String?
  createdAt DateTime @default(now()) @map("created_at")
  products  Product[]

  @@map("suppliers")
}

model Category {
  id       String    @id @default(uuid()) @db.Uuid
  tenantId String    @map("tenant_id") @db.Uuid
  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  name     String
  products Product[]

  @@map("categories")
}

model Product {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  tenant           Tenant    @relation(fields: [tenantId], references: [id])
  sku              String?
  name             String
  categoryId       String?   @map("category_id") @db.Uuid
  category         Category? @relation(fields: [categoryId], references: [id])
  unitOfMeasure    String    @map("unit_of_measure")
  barcode          String?
  supplierId       String?   @map("supplier_id") @db.Uuid
  supplier         Supplier? @relation(fields: [supplierId], references: [id])
  isPerishable     Boolean   @default(false) @map("is_perishable")
  minStockGlobal   Int       @default(0) @map("min_stock_global")
  costPriceCents   Int       @default(0) @map("cost_price_cents")
  salePriceCents   Int       @default(0) @map("sale_price_cents")
  createdAt        DateTime  @default(now()) @map("created_at")
  deletedAt        DateTime? @map("deleted_at")

  storeSettings ProductStoreSetting[]
  batches       Batch[]

  @@unique([tenantId, sku])
  @@map("products")
}

model ProductStoreSetting {
  tenantId         String  @map("tenant_id") @db.Uuid
  productId        String  @map("product_id") @db.Uuid
  product          Product @relation(fields: [productId], references: [id])
  storeId          String  @map("store_id") @db.Uuid
  minStockOverride Int?    @map("min_stock_override")

  @@id([productId, storeId])
  @@map("product_store_settings")
}

model Batch {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  product      Product  @relation(fields: [productId], references: [id])
  storeId      String   @map("store_id") @db.Uuid
  batchNumber  String   @map("batch_number")
  expiryDate   DateTime @map("expiry_date") @db.Date
  quantity     Int      @default(0)
  receivedAt   DateTime @default(now()) @map("received_at")

  @@map("batches")
}

model Customer {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  name      String
  document  String?
  phone     String?
  email     String?
  createdAt DateTime @default(now()) @map("created_at")

  sales Sale[]

  @@map("customers")
}

model StockMovement {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  storeId       String   @map("store_id") @db.Uuid
  batchId       String?  @map("batch_id") @db.Uuid
  type          String
  quantity      Int
  unitCostCents Int?     @map("unit_cost_cents")
  referenceId   String?  @map("reference_id") @db.Uuid
  createdBy     String   @map("created_by") @db.Uuid
  metadata      Json     @default("{}")
  balanceAfter  Int      @map("balance_after")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("stock_movements")
}

model NfeImport {
  id            String    @id @default(uuid()) @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  storeId       String    @map("store_id") @db.Uuid
  supplierId    String?   @map("supplier_id") @db.Uuid
  accessKey     String?   @map("access_key")
  fileRef       String    @map("file_ref")
  status        String    @default("pending_parse")
  errorMessage  String?   @map("error_message")
  importedAt    DateTime  @default(now()) @map("imported_at")
  confirmedBy   String?   @map("confirmed_by") @db.Uuid
  confirmedAt   DateTime? @map("confirmed_at")

  items NfeImportItem[]

  @@map("nfe_imports")
}

model NfeImportItem {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  nfeImportId       String   @map("nfe_import_id") @db.Uuid
  nfeImport         NfeImport @relation(fields: [nfeImportId], references: [id])
  cProd             String   @map("c_prod")
  cEAN              String?  @map("c_ean")
  xProd             String   @map("x_prod")
  ncm               String?
  qCom              Decimal  @map("q_com") @db.Decimal(14, 4)
  vUnComCents       Int      @map("v_un_com_cents")
  matchedProductId  String?  @map("matched_product_id") @db.Uuid
  status            String   @default("unmatched")

  @@map("nfe_import_items")
}

model Sale {
  id                    String   @id @default(uuid()) @db.Uuid
  tenantId              String   @map("tenant_id") @db.Uuid
  storeId               String   @map("store_id") @db.Uuid
  customerId            String?  @map("customer_id") @db.Uuid
  customer              Customer? @relation(fields: [customerId], references: [id])
  sellerId              String   @map("seller_id") @db.Uuid
  totalAmountCents      Int      @map("total_amount_cents")
  paymentMethodLabel    String?  @map("payment_method_label")
  status                String   @default("completed")
  createdAt             DateTime @default(now()) @map("created_at")

  items SaleItem[]

  @@map("sales")
}

model SaleItem {
  id              String  @id @default(uuid()) @db.Uuid
  tenantId        String  @map("tenant_id") @db.Uuid
  saleId          String  @map("sale_id") @db.Uuid
  sale            Sale    @relation(fields: [saleId], references: [id])
  productId       String  @map("product_id") @db.Uuid
  batchId         String? @map("batch_id") @db.Uuid
  quantity        Int
  unitPriceCents  Int     @map("unit_price_cents")

  @@map("sale_items")
}

model Transfer {
  id                   String   @id @default(uuid()) @db.Uuid
  tenantId             String   @map("tenant_id") @db.Uuid
  originStoreId        String   @map("origin_store_id") @db.Uuid
  destinationStoreId   String   @map("destination_store_id") @db.Uuid
  status               String   @default("completed")
  createdBy            String   @map("created_by") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at")

  items TransferItem[]

  @@map("transfers")
}

model TransferItem {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  transferId  String   @map("transfer_id") @db.Uuid
  transfer    Transfer @relation(fields: [transferId], references: [id])
  productId   String   @map("product_id") @db.Uuid
  batchId     String?  @map("batch_id") @db.Uuid
  quantity    Int

  @@map("transfer_items")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @map("tenant_id") @db.Uuid
  type      String
  payload   Json      @default("{}")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("notifications")
}

model StockAlertsConfig {
  tenantId              String  @id @map("tenant_id") @db.Uuid
  tenant                Tenant  @relation(fields: [tenantId], references: [id])
  lowStockAlertEnabled  Boolean @default(true) @map("low_stock_alert_enabled")
  expiryAlertDays       Json    @default("[30,15,7]") @map("expiry_alert_days")

  @@map("stock_alerts_config")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  userId     String?  @map("user_id") @db.Uuid
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  action     String
  before     Json?
  after      Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("audit_log")
}
